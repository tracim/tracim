.toDo__pageContent_on_mytasks .toDo
  &__lists
    display flex
    gap standardSpacing

  &__list
    display flex
    flex-direction column
    height 100%
    flex 1

  &__wrapper
    & .toDo__item
      background-color offWhite

      & .toDoItem
        display flex
        min-height headerHeight
        align-items center
        padding standardSpacing

  &__progressBar_container
    flex 0
    margin 15px 0 15px 0

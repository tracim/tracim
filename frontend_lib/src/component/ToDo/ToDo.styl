@import '../../css/Variable.styl'

.toDo
  display flex
  margin standardSpacing

  &Management > .toDo
    flex-direction column

  &__pageContent_on_mytasks
    flex-direction row
    gap standardSpacing
    & > div
      flex 1
      padding standardSpacing
      margin textSpacing
      border-radius standardBorderRadius
      &:first-child
        background lightBlueOpacity
      &:last-child
        background lightOrangeOpacity

  &__list
    &__title
      font-weight bold

  &__new
    display flex
    flex-direction column
    margin-bottom standardSpacing
    margin-top standardSpacing

    &__toDoText
      display flex
      flex-direction column
      margin-top standardSpacing

      & > textarea
        border none
        border-radius standardBorderRadius
        padding textSpacing
        &:disabled
          border borderStyle

    &Button
      align-self flex-end
      margin-bottom standardSpacing
  &__progressBar
    height textSpacing
    background-color fontColor
    transition 0.5s
    &_container
      background-color lightGrey1
      flex 1
      margin 0px pageSpacing

  &__title
    &_container
      display flex
      align-items center

  &Item
    display flex
    background-color offWhite
    min-height headerHeight
    justify-content flex-start
    align-content center
    align-items center
    padding standardSpacing
    gap standardSpacing
    &__checkbox
      font-size titleFontSize
      &:focus
        outline none
    &__delete:focus
      outline none
    &__timedEvent
      flex 1
    &__content
      flex 6
      align-items baseline
      overflow hidden
      text-overflow ellipsis
      &__navigation
        display flex
        justify-content space-between
        margin-inline-end standardSpacing
        font-weight bold
        & > *
          color fontColor
          font-size metadataFontSize
          &:hover
            color fontColor
            text-decoration underline
      &__task
        unicode-bidi plaintext
      & strong
        unicode-bidi plaintext
    &Checked
      color darkGrey2
      background repeating-linear-gradient(25deg, lightGrey2, lightGrey2 5px, white 5px, white 10px)
      & *
        color darkGrey2

// MEDIAQUERIES

@media (max-width: max-lg)
  .toDo__pageContent_on_mytasks
    flex-direction column
